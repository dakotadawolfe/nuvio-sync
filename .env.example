# AIO Addon fresh-server environment

# Public URL where Stremio and OAuth providers can reach this addon.
# Use https on a real server.
HOST_NAME=https://your-domain.com
PORT=3232
NODE_ENV=production
LOG_LEVEL=info

# Required database. SQLite is easiest for a private server.
DATABASE_URI=sqlite://addon/data/db.sqlite

# Redis is recommended for cache performance. The app can still start without
# Redis, but it will try localhost if this is not set.
REDIS_URL=redis://redis:6379

# Required visible API keys.
TMDB_API_KEY=
TVDB_API_KEY=
RPDB_API_KEY=

# Required Trakt OAuth app.
# Create this at https://trakt.tv/oauth/applications
# Redirect URI must match: https://your-domain.com/api/auth/trakt/callback
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=https://your-domain.com/api/auth/trakt/callback

# Optional protection for first-time config creation/loading.
# ADDON_PASSWORD=

# Optional admin/dashboard protection if you expose admin routes.
# ADMIN_KEY=

# Cache TTLs.
CATALOG_TTL=86400
META_TTL=604800

# Built-in OpenSubtitles v3 proxy. Leave this alone unless you run your own mirror.
OPENSUBTITLES_V3_URL=https://opensubtitles-v3.strem.io
OPENSUBTITLES_V3_TTL=21600

# Optional SubDL fallback for subtitles. Users can also save this per profile as
# apiKeys.subdl through the configure UI.
SUBDL_API_KEY=
SUBDL_LANGUAGES=EN

# Optional private Bleach Kai addon bridge. Use the base URL ending immediately
# before /manifest.json. When set, Bleach Kai appears in normal series search.
BLEACH_KAI_ADDON_BASE_URL=
BLEACH_KAI_FILES_BASE_URL=
